# Copiar a .env en la raíz del repositorio; completar localmente, sin publicar claves.
# Credencial Gemini usada tanto por el LLM como por los embeddings (obligatoria).
LLM_API_KEY=your_api_key_here
# Modelo generativo. Es el que se validó en la Entrega 4; si se omite, se usa este mismo.
LLM_MODEL=gemini-3.1-flash-lite
# Deben coincidir con el modelo y la dimensión de la colección persistida.
# Estos valores son los utilizados y documentados en la Entrega 2.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Observabilidad con LangSmith (Entrega 3 - Parte B)
# Pasar a true recién al completar LANGCHAIN_API_KEY; con la key placeholder falla cada invoke.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=tp-portalia

# Entrega 4 - Agente con LangGraph y API
# Archivo SQLite de la memoria por thread_id (en Docker: /app/state/memoria.sqlite3).
DB_PATH=entrega_4/datos/memoria.sqlite3
# Tope de vueltas agente <-> herramientas por consulta.
MAX_ITERACIONES=5
# Nivel de los logs JSON: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
