# Copiar a .env en la raíz del repositorio; completar localmente, sin publicar claves.
# Credencial Gemini usada tanto por el LLM como por los embeddings (obligatoria).
LLM_API_KEY=your_api_key_here
# Modelo generativo disponible en la cuenta. Reemplazar el placeholder.
# Si se omite o se deja vacío, el código anterior usa gemini-3.6-flash.
LLM_MODEL=your_llm_model_here
# Deben coincidir con el modelo y la dimensión de la colección persistida.
# Estos valores son los utilizados y documentados en la Entrega 2.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Observabilidad con LangSmith (Entrega 3 - Parte B)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=tp-portalia
